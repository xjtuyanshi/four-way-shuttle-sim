{
  "name": "four-way-shuttle-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "vitest run apps/shuttle-api apps/shuttle-dashboard && vitest run packages/shuttle-sim-core",
    "test:watch": "vitest",
    "dev:api": "corepack pnpm --filter shuttle-api dev",
    "dev:dashboard": "corepack pnpm --filter shuttle-dashboard dev",
    "preview:dashboard": "corepack pnpm --filter shuttle-dashboard preview --host 0.0.0.0",
    "shuttle:prereq": "corepack pnpm --filter shuttle-api prereq",
    "shuttle:validate": "corepack pnpm --filter shuttle-api validate:phase0",
    "shuttle:validate:report": "corepack pnpm --filter shuttle-api validate:phase0 ../../output/shuttle/phase0-validation-report.json",
    "shuttle:audit:behavior": "tsx scripts/audit-shuttle-behavior.ts",
    "shuttle:audit:replay": "tsx scripts/audit-shuttle-replay-determinism.ts",
    "shuttle:audit:yellow-grid": "tsx scripts/audit-yellow-grid-contract.ts",
    "shuttle:audit:liveness": "tsx scripts/audit-yellow-grid-liveness.ts",
    "shuttle:audit:watchdog": "tsx scripts/audit-yellow-grid-liveness.ts --duration-sec 7200 --dt-sec 0.2 --sample-sec 300 --max-active-vehicle-still-sec 120",
    "shuttle:des": "tsx scripts/run-headless-des.ts",
    "shuttle:des-optimized": "tsx scripts/run-headless-des.ts --initial-fill-policy zone-balanced-50 --storage-selection-policy traffic-aware --max-active-tasks 6",
    "shuttle:des-review": "tsx scripts/review-des-audit.ts",
    "shuttle:des-review-optimized": "tsx scripts/review-des-audit.ts --initial-fill-policy zone-balanced-50 --storage-selection-policy traffic-aware",
    "shuttle:review-pack": "tsx scripts/build-review-pack.ts",
    "shuttle:review-index": "tsx scripts/build-review-pack-index.ts",
    "shuttle:review-data": "tsx scripts/export-review-data.ts",
    "shuttle:review-verify": "tsx scripts/verify-review-pack.ts",
    "shuttle:review-preflight": "tsx scripts/review-preflight.ts",
    "shuttle:bottleneck-report": "tsx scripts/build-bottleneck-traffic-analysis.ts",
    "shuttle:hotspot-incident": "tsx scripts/build-hotspot-incident-evidence.ts",
    "shuttle:feasible-map": "tsx scripts/build-feasible-area-map.ts",
    "shuttle:uniform-zone-50": "tsx scripts/build-uniform-zone-50-analysis.ts",
    "shuttle:live-env-verify": "tsx scripts/verify-live-review-env.ts",
    "shuttle:dashboard-evidence-verify": "tsx scripts/verify-dashboard-review-evidence.ts",
    "shuttle:site-gap": "tsx scripts/build-site-calibration-gap.ts",
    "shuttle:site-readiness": "tsx scripts/build-site-validation-readiness.ts",
    "shuttle:site-readiness-verify": "tsx scripts/verify-site-validation-readiness.ts",
    "shuttle:site-template-verify": "tsx scripts/verify-site-calibration-template.ts",
    "shuttle:site-current-verify": "tsx scripts/verify-site-calibration-template.ts config/shuttle/customer-site-calibration.current-review.json",
    "shuttle:physical-long": "tsx scripts/run-physical-long.ts",
    "shuttle:replay": "tsx scripts/replay-shuttle-run.ts",
    "shuttle:ws-smoke": "node scripts/smoke-shuttle-ws.mjs",
    "test:shuttle": "vitest run packages/shuttle-sim-core",
    "unreal:setup": "node scripts/setup-unreal-visual-twin.mjs",
    "unreal:build": "node scripts/smoke-unreal-visual-twin.mjs --build-only",
    "unreal:smoke": "node scripts/smoke-unreal-visual-twin.mjs",
    "unreal:stage": "node scripts/stage-unreal-visual-twin.mjs",
    "unreal:pixelstreaming:check": "node scripts/check-pixel-streaming-readiness.mjs",
    "build": "corepack pnpm run typecheck && corepack pnpm --filter shuttle-dashboard build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
